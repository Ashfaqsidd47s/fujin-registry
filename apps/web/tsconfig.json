{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/registry/ui/*": ["../../packages/ui/*"],
      "@/registry/blocks/*": ["../../packages/blocks/*"],
      "@/registry/new-york/ui/card": ["../../packages/ui/card/core/card"],
      "@/registry/new-york/ui/button": ["../../packages/ui/button/core/button"],
      "@/registry/new-york/ui/input": ["../../packages/ui/input/core/input"],
      "@/registry/new-york/ui/textarea": ["../../packages/ui/textarea/core/textarea"],
      "@/registry/new-york/ui/badge": ["../../packages/ui/badge/core/badge"],
      "@/registry/new-york/ui/checkbox": ["../../packages/ui/checkbox/core/checkbox"],
      "@/registry/new-york/ui/switch": ["../../packages/ui/switch/core/switch"],
      "@/registry/new-york/ui/label": ["../../packages/ui/label/core/label"],
      "@/registry/new-york/ui/accordion": ["../../packages/ui/accordion/core/accordion"],
      "@/registry/new-york/ui/aspect-ratio": ["../../packages/ui/aspect-ratio/core/aspect-ratio"],
      "@/registry/new-york/ui/breadcrumb": ["../../packages/ui/breadcrumb/core/breadcrumb"],
      "@/registry/new-york/ui/separator": ["../../packages/ui/separator/core/separator"],
      "@/registry/new-york/ui/tabs": ["../../packages/ui/tabs/core/tabs"],
      "@/registry/new-york/ui/alert": ["../../packages/ui/alert/core/alert"],
      "@/registry/new-york/ui/progress": ["../../packages/ui/progress/core/progress"],
      "@/registry/new-york/ui/skeleton": ["../../packages/ui/skeleton/core/skeleton"],
      "@/registry/new-york/ui/sonner": ["../../packages/ui/sonner/core/sonner"],
      "@/registry/new-york/ui/spinner": ["../../packages/ui/spinner/core/spinner"],
      "@/registry/new-york/ui/toast": ["../../packages/ui/toast/core/toast"],
      "@/registry/new-york/ui/alert-dialog": ["../../packages/ui/alert-dialog/core/alert-dialog"],
      "@/registry/new-york/ui/dialog": ["../../packages/ui/dialog/core/dialog"],
      "@/registry/new-york/ui/drawer": ["../../packages/ui/drawer/core/drawer"],
      "@/registry/new-york/ui/hover-card": ["../../packages/ui/hover-card/core/hover-card"],
      "@/registry/new-york/ui/popover": ["../../packages/ui/popover/core/popover"],
      "@/registry/new-york/ui/sheet": ["../../packages/ui/sheet/core/sheet"],
      "@/registry/new-york/ui/tooltip": ["../../packages/ui/tooltip/core/tooltip"],
      "@/registry/new-york/blocks/*": ["../../packages/blocks/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/**/*.ts", "../../packages/**/*.tsx"],
  "exclude": ["node_modules"]
}
