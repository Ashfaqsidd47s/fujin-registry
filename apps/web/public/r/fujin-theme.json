{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "fujin-theme",
  "title": "Fujin Theme",
  "description": "Fujin's default color palette, radius, and glass surface tokens.",
  "cssVars": {
    "theme": {
      "radius": "1.25rem"
    },
    "light": {
      "primary": "oklch(0.55 0.18 280)",
      "primary-foreground": "oklch(0.98 0 0)",
      "background": "oklch(0.99 0 0)",
      "border": "oklch(0.9 0.01 280 / 60%)",
      "chart-1": "oklch(0.65 0.2 280)",
      "chart-2": "oklch(0.7 0.18 200)",
      "chart-3": "oklch(0.75 0.15 140)",
      "sidebar-primary": "oklch(0.55 0.18 280)",
      "fujin-surface": "oklch(1 0 0 / 55%)",
      "fujin-surface-border": "oklch(1 0 0 / 35%)",
      "fujin-surface-blur": "20px",
      "fujin-surface-shadow": "0 8px 32px oklch(0 0 0 / 14%), inset 0 1px 0 oklch(1 0 0 / 40%)",
      "fujin-radius": "1.25rem"
    },
    "dark": {
      "primary": "oklch(0.75 0.18 280)",
      "background": "oklch(0.12 0 0)",
      "border": "oklch(1 0 0 / 10%)",
      "fujin-surface": "oklch(0.25 0.01 285 / 45%)",
      "fujin-surface-border": "oklch(1 0 0 / 12%)",
      "fujin-surface-shadow": "0 8px 32px oklch(0 0 0 / 40%), inset 0 1px 0 oklch(1 0 0 / 8%)"
    }
  },
  "css": {
    "@layer components": {
      ".fujin-surface": {
        "background": "var(--fujin-surface)",
        "border": "1px solid var(--fujin-surface-border)",
        "backdrop-filter": "blur(var(--fujin-surface-blur))",
        "box-shadow": "var(--fujin-surface-shadow)",
        "border-radius": "var(--fujin-radius)"
      }
    }
  },
  "type": "registry:style"
}